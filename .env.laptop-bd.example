# ============================================================================
# LAPTOP 3 — BASE DE DATOS   ·   IP fija: 192.168.13.3   ·   bd.fandite.com
#
#   1. Copia este archivo como  .env   en la raíz del proyecto.
#   2. Copia a cert/ :  bd.crt , bd.key , ca.crt
#   3. Levanta SOLO la base de datos:   docker compose up -d db
#
# SSL se enciende SOLO: el entrypoint detecta bd.key en cert/ y arranca Postgres
# con TLS. Sin certificados (dev), arranca normal. Ver WORKFLOW-TLS.md (Fase B).
# ============================================================================

POSTGRES_USER=sicad
POSTGRES_PASSWORD=sicad_pass
POSTGRES_DB=sicad

TZ=America/Mexico_City

# La BD queda escuchando en el puerto 5432 de esta máquina, para que el backend
# la alcance desde la laptop 192.168.13.2. Recuerda permitir el puerto en el
# Firewall de Windows (ver RED-DISTRIBUIDA.md).
