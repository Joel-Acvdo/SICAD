# ============================================================================
# LAPTOP 2 — BACKEND (API)   ·   IP fija: 192.168.13.2   ·   backend.fandite.com
#
#   1. Copia este archivo como  .env   en la raíz del proyecto.
#   2. Levanta SOLO el backend:   docker compose up -d --build backend
# ============================================================================

# DATABASE_URL vacío = el backend BUSCA la base de datos solo, en este orden:
#   servicio "db" de Docker → bd.fandite.com → 192.168.13.3 → localhost
# Descoméntalo únicamente si quieres forzar un destino fijo.
# DATABASE_URL=postgresql://sicad:sicad_pass@192.168.13.3:5432/sicad?schema=public

# Dónde buscar la base de datos (si no se fija DATABASE_URL).
DB_HOST_DNS=bd.fandite.com
DB_HOST_IP=192.168.13.3

POSTGRES_USER=sicad
POSTGRES_PASSWORD=sicad_pass
POSTGRES_DB=sicad

JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=1d
NODE_ENV=production
TZ=America/Mexico_City
