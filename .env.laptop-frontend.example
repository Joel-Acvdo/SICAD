# ============================================================================
# LAPTOP 1 — FRONTEND (la app)  ·  IP fija: 192.168.13.1  ·  sicad.fandite.com
#
#   1. Copia este archivo como  .env   en la raíz del proyecto.
#   2. Copia a cert/ :  sicad.crt , sicad.key , ca.crt
#   3. Levanta el frontend + el proxy HTTPS (Nginx):
#          docker compose up -d --build frontend frontend-proxy
#
# Ésta es la única laptop que abren los usuarios y los celulares:
#     https://sicad.fandite.com     (candado cerrado; el QR necesita HTTPS)
# El puerto 80 lo atiende Nginx y redirige a 443. Ver WORKFLOW-TLS.md.
# ============================================================================

# Activa el perfil "tls" POR DEFECTO en esta laptop, para no depender del flag
# --profile en cada comando y que el proxy HTTPS suba solo. Compose lee esta
# variable del .env automáticamente.
COMPOSE_PROFILES=tls

# Con TLS, Nginx (frontend-proxy) ocupa el 80 y el 443. El contenedor del
# frontend se publica en 3000 para no chocar con el 80.
FRONTEND_HOST_PORT=3000

# El navegador siempre llama a /api (mismo origen) y el servidor de Next lo
# reenvía al backend. Así no hay CORS y funciona igual desde un celular.
NEXT_PUBLIC_API_URL=/api

# Con TLS, el backend se sirve por HTTPS (Nginx en su laptop). Fijamos el
# destino cifrado por nombre (el certificado es para backend.fandite.com; NO
# uses IP aquí). El Node de Next confía en la CA vía NODE_EXTRA_CA_CERTS (ya
# configurado en docker-compose.yml montando ca.crt).
BACKEND_URL=https://backend.fandite.com

# Dónde buscar el backend (si no se fija BACKEND_URL).
BACKEND_HOST_DNS=backend.fandite.com
BACKEND_HOST_IP=192.168.13.2

TZ=America/Mexico_City
