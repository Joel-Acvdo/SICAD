# ============================================================================
# LAPTOP 1 — FRONTEND (la app)  ·  IP fija: 192.168.13.1  ·  sicad.fandite.com
#
#   1. Copia este archivo como  .env   en la raíz del proyecto.
#   2. Levanta SOLO el frontend:   docker compose up -d --build frontend
#
# Ésta es la única laptop que abren los usuarios y los celulares:
#     http://sicad.fandite.com:3000     (o  http://192.168.13.1:3000)
# ============================================================================

# El navegador siempre llama a /api (mismo origen) y el servidor de Next lo
# reenvía al backend. Así no hay CORS y funciona igual desde un celular.
NEXT_PUBLIC_API_URL=/api

# BACKEND_URL vacío = el frontend BUSCA el backend solo, en este orden:
#   servicio "backend" de Docker → backend.fandite.com → 192.168.13.2 → localhost
# y lo revalida cada 30 s (si el backend cambia de laptop, lo reencuentra).
# Descoméntalo únicamente si quieres forzar un destino fijo.
# BACKEND_URL=http://192.168.13.2:4000

# Dónde buscar el backend (si no se fija BACKEND_URL).
BACKEND_HOST_DNS=backend.fandite.com
BACKEND_HOST_IP=192.168.13.2

TZ=America/Mexico_City
